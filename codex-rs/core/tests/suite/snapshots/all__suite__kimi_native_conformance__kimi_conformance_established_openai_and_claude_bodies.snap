{
  "claude": {
    "context_management": {
      "edits": [
        {
          "keep": "all",
          "type": "clear_thinking_20251015"
        }
      ]
    },
    "max_tokens": 64000,
    "messages": [
      {
        "content": [
          {
            "cache_control": {
              "ttl": "1h",
              "type": "ephemeral"
            },
            "text": "messages fixture prompt",
            "type": "text"
          }
        ],
        "role": "user"
      }
    ],
    "model": "claude-sonnet-5",
    "output_config": {
      "effort": "high"
    },
    "stream": true,
    "system": [
      {
        "cache_control": {
          "ttl": "1h",
          "type": "ephemeral"
        },
        "text": "system",
        "type": "text"
      }
    ],
    "thinking": {
      "display": "omitted",
      "type": "adaptive"
    }
  },
  "openai": {
    "client_metadata": {
      "session_id": "<session_id>",
      "thread_id": "<thread_id>",
      "turn_id": "<turn_id>",
      "x-codex-installation-id": "<x-codex-installation-id>",
      "x-codex-turn-metadata": "<x-codex-turn-metadata>",
      "x-codex-window-id": "<x-codex-window-id>"
    },
    "include": [
      "reasoning.encrypted_content"
    ],
    "input": [
      {
        "content": [
          {
            "text": "responses fixture prompt",
            "type": "input_text"
          }
        ],
        "id": "<id>",
        "internal_chat_message_metadata_passthrough": {
          "turn_id": "<turn_id>"
        },
        "role": "user",
        "type": "message"
      }
    ],
    "instructions": "responses fixture system",
    "model": "gpt-5.5",
    "parallel_tool_calls": true,
    "prompt_cache_key": "<prompt_cache_key>",
    "reasoning": {
      "effort": "medium"
    },
    "store": false,
    "stream": true,
    "text": {
      "verbosity": "low"
    },
    "tool_choice": "auto",
    "tools": []
  }

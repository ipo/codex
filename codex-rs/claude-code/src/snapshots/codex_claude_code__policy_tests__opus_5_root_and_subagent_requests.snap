      "system": [
        {
          "type": "text",
          "text": "x-anthropic-billing-header: cc_version=2.1.224.b44; cc_entrypoint=cli; cc_is_subagent=true;"
        },
        {
          "type": "text",
          "text": "You are Claude Code, Anthropic's official CLI for Claude.",
          "cache_control": {
